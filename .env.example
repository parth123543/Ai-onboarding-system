# Microsoft Innovate 2026 - AI Onboarding Assistant (PS15)
PROJECT_NAME="Microsoft Innovate 2026 - AI Onboarding Assistant (PS15)"
ENVIRONMENT=development
SECRET_KEY=microsoft-innovate-2026-hackathon-super-secret-key-ps15-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database & Redis
DATABASE_URL=sqlite+aiosqlite:///./onboarding.db
# For PostgreSQL with pgvector in Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/onboarding_db
REDIS_URL=redis://localhost:6379/0

# Azure OpenAI Service API (GPT-4o + Embeddings)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Standard OpenAI Fallback (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Slack Proactive Nudges & Escalations
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Transactional Email (SendGrid / Azure Communication Services)
SENDGRID_API_KEY=
EMAIL_FROM=onboarding@contoso.microsoft.com

# Microsoft Bot Framework / Teams Bot (Stretch Goal)
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
